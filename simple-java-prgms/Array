varargs : 

public class Main {

    public static void main(String[] args) {

        System.out.println(add(11,24,53,7));
    }
    static int add(int... numbers){
        int sum = 0;

        for(int number : numbers){
            sum+= number;
        }
        return sum;
    }
}
